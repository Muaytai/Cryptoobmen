#!/bin/bash
# Полный запуск всей Celery системы (workers + beat)
cd /home/chaizer/projects/Cryptoobmen/backend
source venv/bin/activate

echo "🛑 Остановка всех Celery процессов..."

# Останавливаем все Celery процессы
pkill -f "celery.*worker" && echo "   ✓ Workers остановлены" || echo "   - Workers не запущены"
pkill -f "celery.*beat" && echo "   ✓ Beat остановлен" || echo "   - Beat не запущен"

# Ждем корректного завершения
echo "⏳ Ожидание завершения процессов..."
sleep 3

# Принудительно завершаем оставшиеся процессы
REMAINING=$(ps aux | grep -E "celery" | grep -v grep | wc -l)
if [ $REMAINING -gt 0 ]; then
    echo "⚠️  Принудительное завершение оставшихся процессов..."
    pkill -9 -f "celery"
    sleep 2
fi

echo "🚀 Запуск всей Celery системы..."

# Запускаем Workers
echo "   Starting high priority worker..."
celery -A core worker -l info -Q high_priority -n high_priority_worker --concurrency=2 &
HIGH_PID=$!

echo "   Starting medium priority worker..."
celery -A core worker -l info -Q medium_priority -n medium_priority_worker --concurrency=2 &
MEDIUM_PID=$!

echo "   Starting low priority worker..."
celery -A core worker -l info -Q low_priority -n low_priority_worker --concurrency=2 &
LOW_PID=$!

# Ждем запуска workers
sleep 3

echo "   Starting beat scheduler..."
celery -A core beat --loglevel=info &
BEAT_PID=$!

# Ждем запуска всех компонентов
sleep 2

echo ""
echo "✅ Вся Celery система запущена!"
echo ""
echo "📊 Запущенные процессы:"
ps aux | grep -E "celery.*(worker|beat)" | grep -v grep | awk '{print "   PID " $2 ": " $11 " " $12 " " $13 " " $14 " " $15}'

echo ""
echo "🔧 Команды управления:"
echo "   Остановка всего: pkill -f celery"
echo "   Остановка workers: pkill -f 'celery.*worker'"  
echo "   Остановка beat: pkill -f 'celery.*beat'"
echo "   Проверка статуса: ps aux | grep celery"
echo ""
echo "📈 Мониторинг:"
echo "   Активные задачи: celery -A core inspect active"
echo "   Статистика: celery -A core inspect stats"
echo ""

# Функция для graceful shutdown
cleanup() {
    echo ""
    echo "🛑 Получен сигнал завершения, останавливаем все процессы..."
    pkill -P $$  # Останавливаем дочерние процессы
    exit 0
}

# Перехватываем сигналы завершения
trap cleanup SIGINT SIGTERM

echo "🟢 Система работает. Нажмите Ctrl+C для остановки."
echo "📝 Логи выводятся в реальном времени..."

# Ожидание завершения всех процессов
wait

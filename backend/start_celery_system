# Готовим потоки с префиксами для наглядности
{
  tail -n 0 -F /tmp/celery_high.log   | sed -u 's/^/[HIGH] \t/' &
  T1=$!
  tail -n 0 -F /tmp/celery_medium.log | sed -u 's/^/[MED ] \t/' &
  T2=$!
  tail -n 0 -F /tmp/celery_low.log    | sed -u 's/^/[LOW ] \t/' &
  T3=$!
  tail -n 0 -F /tmp/celery_beat.log   | sed -u 's/^/[BEAT] \t/' &
  T4=$!

  # Корректное завершение по Ctrl+C
  trap 'kill $T1 $T2 $T3 $T4 2>/dev/null; echo "\n🛑 Подписка на логи остановлена"; exit 0' INT TERM
  wait
}


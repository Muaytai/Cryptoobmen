#!/bin/bash
# Полный запуск Celery системы (Workers + Beat)

# Переходим в директорию, где лежит сам скрипт (backend), чтобы не хардкодить путь
cd /mnt/d/progects/Cryptoobmen/backend

echo "🚀 Запуск полной Celery системы..."
echo ""

# Останавливаем все старые процессы
echo "🛑 Остановка старых процессов..."
pkill -f "celery.*worker" 2>/dev/null
pkill -f "celery.*beat" 2>/dev/null
echo "   Процессы остановлены"
sleep 3
echo "   Ожидание завершено"

echo ""
echo "🔧 Запуск Workers..."

# Запускаем workers с активированным виртуальным окружением
echo "   🚀 Запуск High priority worker..."
nohup bash -c "source venv/bin/activate && celery -A core worker -l info -Q high_priority -n high_priority_worker --concurrency=2" > /tmp/celery_high.log 2>&1 &
HIGH_PID=$!
echo "   ⚡ High priority worker: PID $HIGH_PID"

echo "   🚀 Запуск Medium priority worker..."
nohup bash -c "source venv/bin/activate && celery -A core worker -l info -Q medium_priority -n medium_priority_worker --concurrency=2" > /tmp/celery_medium.log 2>&1 &
MEDIUM_PID=$!
echo "   🔄 Medium priority worker: PID $MEDIUM_PID"

echo "   🚀 Запуск Low priority worker..."
nohup bash -c "source venv/bin/activate && celery -A core worker -l info -Q low_priority -n low_priority_worker --concurrency=2" > /tmp/celery_low.log 2>&1 &
LOW_PID=$!
echo "   📊 Low priority worker: PID $LOW_PID"

sleep 3

echo ""
echo "⏰ Запуск Beat scheduler..."
echo "   🚀 Запуск Beat scheduler..."
nohup bash -c "source venv/bin/activate && celery -A core beat --loglevel=info" > /tmp/celery_beat.log 2>&1 &
BEAT_PID=$!
echo "   🕒 Beat scheduler: PID $BEAT_PID"

sleep 3

echo ""
echo "✅ Система запущена!"
echo ""
echo "📊 Статус процессов:"
WORKER_COUNT=$(ps aux | grep -E "celery.*worker" | grep -v grep | wc -l)
BEAT_COUNT=$(ps aux | grep -E "celery.*beat" | grep -v grep | wc -l)
echo "   Workers: $WORKER_COUNT процессов"
echo "   Beat: $BEAT_COUNT процесс"

echo ""
echo "🔧 Управление:"
echo "   Остановка всего: ./stop_celery_system"
echo "   Только workers: pkill -f 'celery.*worker'"
echo "   Только beat: pkill -f 'celery.*beat'"
echo "   Статус: ps aux | grep celery"
echo "   Мониторинг: bash -c 'source venv/bin/activate && celery -A core inspect active'"

echo ""
echo "🟢 Система готова к работе!"

# Если запущен не в фоне, ждем сигнала завершения
if [ "$1" != "--daemon" ]; then
    echo ""
    echo "💡 Нажмите Ctrl+C для остановки системы"
    
    # Обработчик сигналов
    trap 'echo ""; echo "🛑 Остановка системы..."; pkill -f "celery.*worker" 2>/dev/null; pkill -f "celery.*beat" 2>/dev/null; sleep 2; echo "✅ Система остановлена"; exit 0' SIGINT SIGTERM
    
    # Ждем сигнала
    wait
fi
# Режим окружения
NODE_ENV=development

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Настройки аутентификации
NEXT_PUBLIC_AUTH_COOKIE_NAME=access_token
NEXT_PUBLIC_AUTH_COOKIE_MAX_AGE=2592000 # 30 дней в секундах

# Настройки безопасности для разработки
NEXT_PUBLIC_SECURE_COOKIE=false
NEXT_PUBLIC_SAME_SITE=lax

# Дополнительные настройки
NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_ENABLE_LOGS=true

# WebSocket URL для real-time функционала
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

